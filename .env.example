# Base de datos: Postgres (Neon).
# DATABASE_URL = cadena AGRUPADA (pooled, con -pooler), para el runtime serverless.
DATABASE_URL="postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL = cadena DIRECTA (sin -pooler), para migraciones / db push.
DIRECT_URL="postgresql://usuario:clave@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Duración global de la partida en segundos (timer autoritativo). 5400 = 90 min.
NEXT_PUBLIC_DURACION_PARTIDA_SEG="5400"

# --- Auth.js ---
# Secreto para firmar los JWT de sesión (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# URL pública del sitio (en Vercel suele inferirse por trustHost; útil fijarla):
AUTH_URL="https://tu-proyecto.vercel.app"
# Código de invitación para registrar cuentas con rol DOCENTE
CODIGO_INVITACION_DOCENTE="UT-DOCENTE"
# Enlace mágico (magic link). En desarrollo el enlace se imprime en consola.
# En producción, configura un SMTP:
# EMAIL_SERVER="smtp://usuario:clave@smtp.tu-proveedor.com:587"
# EMAIL_FROM="no-reply@senalperdida.edu.co"
