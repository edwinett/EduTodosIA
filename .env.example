# Base de datos
# Desarrollo (SQLite):
DATABASE_URL="file:./dev.db"
# Producción (Postgres), ejemplo:
# DATABASE_URL="postgresql://usuario:clave@host:5432/senal_perdida?schema=public"

# Clave del panel docente (cámbiala en producción)
DOCENTE_PASSWORD="tolima2024"

# Secreto para firmar las cookies de sesión del servidor
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Duración global de la partida en segundos (timer autoritativo)
NEXT_PUBLIC_DURACION_PARTIDA_SEG="2700"

# --- Auth.js ---
# Secreto para firmar los JWT de sesión (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# Código de invitación para registrar cuentas con rol DOCENTE
CODIGO_INVITACION_DOCENTE="UT-DOCENTE"
# Enlace mágico (magic link). En desarrollo el enlace se imprime en consola.
# En producción, configura un SMTP:
# EMAIL_SERVER="smtp://usuario:clave@smtp.tu-proveedor.com:587"
# EMAIL_FROM="no-reply@senalperdida.edu.co"
